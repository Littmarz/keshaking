# --- backend ---
AGENT_MODE=mock                      # mock | real
DATABASE_URL=sqlite:///./data/app.db
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:5173
AGENT_TIMEOUT_S=120
HISTORY_TURNS=4
LOW_SCORE_THRESHOLD=0.3

# --- актуальность редакций ---
REFERENCE_DATE=                      # пусто = сегодня; в корпусе дат нет → статус unknown

# --- llm (Ollama, OpenAI-совместимый API) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b                   # D-004; Ollama нативно на Mac. Из docker: http://host.docker.internal:11434/v1
LLM_API_KEY=not-needed
# num_ctx через /v1 не передаётся — задаётся на стороне сервера Ollama:
OLLAMA_CONTEXT_LENGTH=16384

# --- вход и тестовая почта ---
PUNKT_EMPLOYEE_PASSWORD=
PUNKT_QUALITY_PASSWORD=
PUNKT_MAIL_PASSWORD=                 # для PUNKT_TEST_MAIL=1, например openssl rand -hex 24

# --- служба качества ---
TICKET_PREFIX=Q-
QA_DEMO_LABEL=учебный ответ службы качества

# --- retrieval ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chunks
# Корень моделей. Локально — ./models/hf, в контейнере — /models/hf (так смонтирован volume).
MODELS_DIR=./models/hf
EMBED_MODEL=bge-m3                   # полный путь = MODELS_DIR/EMBED_MODEL
RERANK_MODEL=bge-reranker-v2-m3
HF_HUB_OFFLINE=1

# --- frontend ---
VITE_API_URL=/api
