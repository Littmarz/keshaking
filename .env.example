# --- backend ---
AGENT_MODE=mock                      # mock | real
DATABASE_URL=sqlite:///./data/app.db
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:5173
AGENT_TIMEOUT_S=120
HISTORY_TURNS=4
LOW_SCORE_THRESHOLD=0.3

# --- llm (Ollama или vLLM, OpenAI-совместимый API) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=not-needed

# --- retrieval ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chunks
EMBED_MODEL_PATH=./models/hf/bge-m3
RERANK_MODEL_PATH=./models/hf/bge-reranker-v2-m3
HF_HUB_OFFLINE=1

# --- frontend ---
VITE_API_URL=/api
